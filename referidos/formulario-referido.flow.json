{
  "version": "7.2",
  "screens": [
    {
      "id": "REFERIDO",
      "title": "Recomienda a alguien",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Cuéntanos a quién nos recomiendas. Un asesor de Espazios lo llamará en menos de 8 horas hábiles."
          },
          {
            "type": "TextInput",
            "name": "nombre_referidor",
            "label": "Tu nombre",
            "input-type": "text",
            "required": true,
            "max-chars": 60
          },
          {
            "type": "TextInput",
            "name": "nombre_referido",
            "label": "Nombre de la persona",
            "input-type": "text",
            "required": true,
            "max-chars": 60
          },
          {
            "type": "Dropdown",
            "name": "indicativo",
            "label": "Indicativo del país",
            "required": true,
            "init-value": "57",
            "data-source": [
              {
                "id": "57",
                "title": "🇨🇴 Colombia (+57)"
              },
              {
                "id": "1",
                "title": "🇺🇸 Estados Unidos / Canadá (+1)"
              },
              {
                "id": "34",
                "title": "🇪🇸 España (+34)"
              },
              {
                "id": "52",
                "title": "🇲🇽 México (+52)"
              },
              {
                "id": "58",
                "title": "🇻🇪 Venezuela (+58)"
              },
              {
                "id": "593",
                "title": "🇪🇨 Ecuador (+593)"
              },
              {
                "id": "51",
                "title": "🇵🇪 Perú (+51)"
              },
              {
                "id": "507",
                "title": "🇵🇦 Panamá (+507)"
              },
              {
                "id": "56",
                "title": "🇨🇱 Chile (+56)"
              },
              {
                "id": "54",
                "title": "🇦🇷 Argentina (+54)"
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "celular_referido",
            "label": "Celular de la persona",
            "input-type": "phone",
            "required": true,
            "helper-text": "Sin indicativo, ej. 3001234567"
          },
          {
            "type": "TextInput",
            "name": "correo_referido",
            "label": "Correo de la persona (opcional)",
            "input-type": "email",
            "required": false,
            "helper-text": "ej. nombre@correo.com"
          },
          {
            "type": "Dropdown",
            "name": "ciudad",
            "label": "Ciudad",
            "required": true,
            "data-source": [
              {
                "id": "bogota",
                "title": "Bogotá"
              },
              {
                "id": "soacha",
                "title": "Soacha"
              },
              {
                "id": "mosquera",
                "title": "Mosquera"
              },
              {
                "id": "madrid",
                "title": "Madrid"
              },
              {
                "id": "chia",
                "title": "Chía"
              },
              {
                "id": "cota",
                "title": "Cota"
              },
              {
                "id": "zipaquira",
                "title": "Zipaquirá"
              },
              {
                "id": "cajica",
                "title": "Cajicá"
              },
              {
                "id": "la_calera",
                "title": "La Calera"
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "barrio_conjunto",
            "label": "Barrio o conjunto",
            "input-type": "text",
            "required": true,
            "max-chars": 80,
            "helper-text": "Ej. Colina Campestre, Conjunto Ankara"
          },
          {
            "type": "Dropdown",
            "name": "tipo_proyecto",
            "label": "¿Qué necesita?",
            "required": true,
            "data-source": [
              {
                "id": "obra_blanca",
                "title": "Solo Obra Blanca"
              },
              {
                "id": "intermedio",
                "title": "Intermedio"
              },
              {
                "id": "remodelacion_total",
                "title": "Remodelación Total"
              },
              {
                "id": "carpinteria",
                "title": "Carpintería"
              },
              {
                "id": "no_sabe",
                "title": "No estoy seguro"
              }
            ]
          },
          {
            "type": "TextArea",
            "name": "comentario",
            "label": "Comentario (opcional)",
            "required": false,
            "max-length": 300
          },
          {
            "type": "OptIn",
            "name": "consentimiento",
            "label": "La persona sabe y aceptó que Espazios la contacte.",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Enviar",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "nombre_referidor": "${form.nombre_referidor}",
                "nombre_referido": "${form.nombre_referido}",
                "indicativo": "${form.indicativo}",
                "celular_referido": "${form.celular_referido}",
                "correo_referido": "${form.correo_referido}",
                "ciudad": "${form.ciudad}",
                "barrio_conjunto": "${form.barrio_conjunto}",
                "tipo_proyecto": "${form.tipo_proyecto}",
                "comentario": "${form.comentario}",
                "consentimiento": "${form.consentimiento}"
              }
            }
          }
        ]
      }
    }
  ]
}
