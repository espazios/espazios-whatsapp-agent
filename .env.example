# --- Google (cuenta de servicio) ---
# Ruta al JSON de credenciales descargado desde Google Cloud Console.
# NUNCA se commitea; se referencia por ruta o se pega el contenido en GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/service-account.json

# ID del archivo de la plantilla unica del cotizador en Drive
# (se obtiene de la URL: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
COTIZADOR_TEMPLATE_ID=

# ID de la carpeta de Drive donde se guardan las copias diligenciadas + PDFs generados
COTIZADOR_OUTPUT_FOLDER_ID=

# gid (id de pestana) de la hoja/tab que debe exportarse como PDF del cotizador
COTIZADOR_PRINT_SHEET_GID=0

# --- WhatsApp via Kapso (BSP sobre la Cloud API de Meta) ---
# API key del proyecto, desde el dashboard de Kapso (Integrations > API keys)
KAPSO_API_KEY=
# ID del numero de telefono conectado en Kapso
KAPSO_PHONE_NUMBER_ID=
# Secreto para verificar la firma de los webhooks que Kapso reenvia a /webhooks/kapso
KAPSO_WEBHOOK_SECRET=

PORT=3000

# --- HubSpot ---
HUBSPOT_PRIVATE_APP_TOKEN=
