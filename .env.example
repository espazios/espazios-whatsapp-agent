# --- Google (cuenta de servicio) ---
# Ruta al JSON de credenciales descargado desde Google Cloud Console.
# NUNCA se commitea; se referencia por ruta o se pega el contenido en GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/service-account.json

# ID del archivo de la plantilla unica del cotizador en Drive
# (se obtiene de la URL: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
COTIZADOR_TEMPLATE_ID=

# ID de la carpeta de Drive donde se guardan las copias diligenciadas + PDFs generados
COTIZADOR_OUTPUT_FOLDER_ID=

# gid (id de pestana) de la hoja/tab que debe exportarse como PDF del cotizador
COTIZADOR_PRINT_SHEET_GID=0

# ID de "Tarifas Ilustrativas - Isa (Cotizador WhatsApp)" — hoja limpia y
# separada de la plantilla operativa, solo con paquete/m2_min/m2_max/precio_desde.
# https://docs.google.com/spreadsheets/d/1p_36FXsl0dSvV3EvDgln2XALR3gTIdji82xsYihx7oc/edit
TARIFAS_ILUSTRATIVAS_SHEET_ID=1p_36FXsl0dSvV3EvDgln2XALR3gTIdji82xsYihx7oc

# --- WhatsApp via Kapso ---
# El "agent node" del Workflow de Kapso es el cerebro de la conversacion y
# quien manda/recibe WhatsApp — este repo NO recibe webhooks de Kapso.
# KAPSO_API_KEY / KAPSO_PHONE_NUMBER_ID se usan para: (1) el envio de
# seguimientos programados (kapso-client.ts), que sale desde nuestro lado;
# y (2) probar/invocar directamente las Kapso Functions de
# kapso-functions/ (guardar_lead, leads_reporte) via curl/API — el deploy
# de esas funciones es manual (dashboard de Kapso), pero la key sirve
# para probarlas desde una maquina con salida de red a api.kapso.ai.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=

# --- Servidor de herramientas (src/tools-server.ts) ---
# URL publica donde el agent node de Kapso puede alcanzar este servidor
# (tunel en desarrollo, dominio real una vez desplegado).
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# --- Scheduler de seguimientos por inactividad, v2 (2026-09-25) ---
# Reemplaza al tick viejo contra la Kapso Function `process-followups`
# (la que dio 404 sin resolver durante semanas — ver CLAUDE.md y
# docs/isa-v2-system-prompt.md). Ahora la logica de negocio (validar,
# calcular cadencia, armar el mensaje) vive en src/followups/ — Railway
# solo necesita que Kapso exponga 4 endpoints delgados sobre su tabla D1
# `conversation_followups` (que Railway no puede tocar directo). Ver
# src/followups/processor.ts para el contrato exacto de cada uno.
# Mientras cualquiera de las 4 URLs o el token queden vacios, el tick se
# queda sin efecto (log de warning), no rompe el resto del servidor.
#
# Las 4 son Kapso Functions nuevas, TODAVIA POR CONSTRUIR del lado de
# Kapso (pendiente a la fecha de este comentario):
# - FOLLOWUPS_LIST_URL: lista conversation_followups vencidos (status
#   'pending' AND next_due_at <= now), sin validar nada de negocio.
# - FOLLOWUPS_CLAIM_URL: UPDATE condicional a status='processing' (evita
#   que dos instancias procesen la misma fila).
# - FOLLOWUPS_VALIDATE_URL: corre las 4 validaciones (mensaje nuevo,
#   agendamiento confirmado, no viable, conversacion activa) y cancela la
#   cadena del lado de Kapso si alguna falla.
# - FOLLOWUPS_RESOLVE_URL: despues de enviar (o fallar), avanza el
#   intento/next_due_at o cierra la cadena.
FOLLOWUPS_LIST_URL=
FOLLOWUPS_CLAIM_URL=
FOLLOWUPS_VALIDATE_URL=
FOLLOWUPS_RESOLVE_URL=
# Secret compartido con las 4 funciones de arriba, header `x-api-key`
# (no "authorization"). Mismo que ya existia para process-followups —
# se puede reutilizar el mismo valor. Generar con: openssl rand -hex 32
FOLLOWUPS_PROCESS_TOKEN=

# --- HubSpot ---
HUBSPOT_PRIVATE_APP_TOKEN=
