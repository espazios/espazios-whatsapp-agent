# --- Google (cuenta de servicio) ---
# Ruta al JSON de credenciales descargado desde Google Cloud Console.
# NUNCA se commitea; se referencia por ruta o se pega el contenido en GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/service-account.json

# ID del archivo de la plantilla unica del cotizador en Drive
# (se obtiene de la URL: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
COTIZADOR_TEMPLATE_ID=

# ID de la carpeta de Drive donde se guardan las copias diligenciadas + PDFs generados
COTIZADOR_OUTPUT_FOLDER_ID=

# gid (id de pestana) de la hoja/tab que debe exportarse como PDF del cotizador
COTIZADOR_PRINT_SHEET_GID=0

# ID de "Tarifas Ilustrativas - Isa (Cotizador WhatsApp)" — hoja limpia y
# separada de la plantilla operativa, solo con paquete/m2_min/m2_max/precio_desde.
# https://docs.google.com/spreadsheets/d/1p_36FXsl0dSvV3EvDgln2XALR3gTIdji82xsYihx7oc/edit
TARIFAS_ILUSTRATIVAS_SHEET_ID=1p_36FXsl0dSvV3EvDgln2XALR3gTIdji82xsYihx7oc

# --- WhatsApp via Kapso ---
# El "agent node" del Workflow de Kapso es el cerebro de la conversacion y
# quien manda/recibe WhatsApp — este repo NO recibe webhooks de Kapso.
# KAPSO_API_KEY / KAPSO_PHONE_NUMBER_ID solo se usan para el envio de
# seguimientos programados (kapso-client.ts), que sale desde nuestro lado.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=

# --- Servidor de herramientas (src/tools-server.ts) ---
# URL publica donde el agent node de Kapso puede alcanzar este servidor
# (tunel en desarrollo, dominio real una vez desplegado).
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# --- HubSpot ---
HUBSPOT_PRIVATE_APP_TOKEN=
