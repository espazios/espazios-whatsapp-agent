# Variables del servidor de herramientas (src/tools-server.ts, corre en Railway).
# .env nunca se commitea.

# --- Google ---
# Credenciales (usuario OAuth autorizado). En Railway va el contenido del JSON
# en GOOGLE_SERVICE_ACCOUNT_JSON; en local se puede usar la ruta al archivo.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Hoja "Tarifas Ilustrativas - Isa" (precios por m2 y contenido de cada paquete).
TARIFAS_ILUSTRATIVAS_SHEET_ID=1p_36FXsl0dSvV3EvDgln2XALR3gTIdji82xsYihx7oc

# --- Servidor ---
# URL publica de este servidor (en Railway: ${{RAILWAY_PUBLIC_DOMAIN}} con https).
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# --- Seguimientos automaticos de Isa v3 ---
# Kapso Function que envia los seguimientos vencidos; este servidor la llama
# cada minuto. Vacio = URL por defecto en el codigo; "off" = apagado.
ISA3_SEGUIMIENTOS_URL=
# Opcional: clave compartida con la funcion (secret ISA3_TICK_TOKEN en Kapso).
ISA3_TICK_TOKEN=

# --- Pruebas manuales contra la API de Kapso (no lo usa el servidor) ---
KAPSO_API_KEY=

# --- HubSpot (pendiente de construir) ---
HUBSPOT_PRIVATE_APP_TOKEN=
